# ARGS : 10 20

@foo(x : int): int {
  two: int = const 2;
  tmp: int = mul x two;
  r: int = div tmp two;
  ret r;
}

@bar(pa: ptr<int>, pb: ptr<int>) {
  la: int = load pa;
  foola: int = call @foo la;
  store pb foola;

  la2: int = load pa;
  lb: int = load pb;
  
  cmp: bool = eq la2 lb;
  cond: bool = not cmp;
  br cond .thn .els;

  .thn:
    one_hundred: int = const 100;
    print one_hundred;
  
  .els:
    la3: int = load pa;
    foola3: int = call @foo la3;
    store pa foola3;
}

@main(x: int, y: int) {
  zero: int = const 0;
  one: int = const 1;
  two: int = const 2;
  pa: ptr<int> = alloc two;
  pb: ptr<int> = ptradd pa one;

  store pa x;
  store pb y;
  
  call @bar pa pb;

  ret;
}
