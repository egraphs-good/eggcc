; Direct structural analysis over exactly the shared ground types and tag laws.
(relation StructuralManualBaseDQ (BaseType BaseType))
(relation StructuralManualListDQ (TypeList TypeList))
(relation StructuralManualTypeDQ (Type Type))
(rule ((StructuralBaseTagDQ a b))
      ((StructuralManualBaseDQ a b)) :ruleset type-helpers)
(rule ((StructuralListTagDQ a b))
      ((StructuralManualListDQ a b)) :ruleset type-helpers)
(rule ((StructuralTypeTagDQ a b))
      ((StructuralManualTypeDQ a b)) :ruleset type-helpers)
(rule ((= a (PointerT x)) (= b (PointerT y))
       (StructuralGroundBase a) (StructuralGroundBase b) (StructuralManualBaseDQ x y))
      ((StructuralManualBaseDQ a b)) :ruleset type-helpers)
(rule ((= a (TCons x xs)) (= b (TCons y ys))
       (StructuralGroundList a) (StructuralGroundList b) (StructuralManualBaseDQ x y))
      ((StructuralManualListDQ a b)) :ruleset type-helpers)
(rule ((= a (TCons x xs)) (= b (TCons y ys))
       (StructuralGroundList a) (StructuralGroundList b) (StructuralManualListDQ xs ys))
      ((StructuralManualListDQ a b)) :ruleset type-helpers)
(rule ((= a (Base x)) (= b (Base y))
       (StructuralGroundType a) (StructuralGroundType b) (StructuralManualBaseDQ x y))
      ((StructuralManualTypeDQ a b)) :ruleset type-helpers)
(rule ((= a (TupleT x)) (= b (TupleT y))
       (StructuralGroundType a) (StructuralGroundType b) (StructuralManualListDQ x y))
      ((StructuralManualTypeDQ a b)) :ruleset type-helpers)
