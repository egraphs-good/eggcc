; Finite free type metadata only. No rules certify helper or sentinel nodes.
(relation StructuralGroundBase (BaseType))
(relation StructuralGroundList (TypeList))
(relation StructuralGroundType (Type))
(relation StructuralBaseTagDQ (BaseType BaseType))
(relation StructuralListTagDQ (TypeList TypeList))
(relation StructuralTypeTagDQ (Type Type))
(relation StructuralTypeMismatch (Type Type))
(function StructuralTypeHasActual (Expr Type) i64 :merge (max old new))
(function StructuralTypeCoverage (Expr Type Type) i64 :merge (max old new))
(ruleset structural-type-consume)

(StructuralGroundBase (IntT))
(StructuralGroundBase (BoolT))
(StructuralGroundBase (FloatT))
(StructuralGroundBase (StateT))
(StructuralGroundList (TNil))
(StructuralBaseTagDQ (IntT) (BoolT))
(StructuralBaseTagDQ (IntT) (FloatT))
(StructuralBaseTagDQ (IntT) (StateT))
(StructuralBaseTagDQ (BoolT) (FloatT))
(StructuralBaseTagDQ (BoolT) (StateT))
(StructuralBaseTagDQ (FloatT) (StateT))

(rule ((= p (PointerT child)) (StructuralGroundBase child))
      ((StructuralGroundBase p)
       (StructuralBaseTagDQ (IntT) p)
       (StructuralBaseTagDQ (BoolT) p)
       (StructuralBaseTagDQ (FloatT) p)
       (StructuralBaseTagDQ (StateT) p)) :ruleset type-helpers)
(rule ((= l (TCons head tail)) (StructuralGroundBase head) (StructuralGroundList tail))
      ((StructuralGroundList l) (StructuralListTagDQ (TNil) l)) :ruleset type-helpers)
(rule ((= t (Base b)) (StructuralGroundBase b))
      ((StructuralGroundType t)) :ruleset type-helpers)
(rule ((= t (TupleT l)) (StructuralGroundList l))
      ((StructuralGroundType t)) :ruleset type-helpers)
(rule ((= a (Base b)) (= c (TupleT l)) (StructuralGroundBase b) (StructuralGroundList l))
      ((StructuralTypeTagDQ a c)) :ruleset type-helpers)

; Explicit tag laws are shared by Manual and the engine-query arms.
(rule ((StructuralBaseTagDQ a b))
      ((StructuralBaseTagDQ b a) (disequal a b)) :ruleset type-helpers)
(rule ((StructuralListTagDQ a b))
      ((StructuralListTagDQ b a) (disequal a b)) :ruleset type-helpers)
(rule ((StructuralTypeTagDQ a b))
      ((StructuralTypeTagDQ b a) (disequal a b)) :ruleset type-helpers)

; Reject corrupted metadata before equal obligations can count as validated.
(rule ((StructuralBaseTagDQ a a))
      ((panic "structural-type-inconsistent-tags: BaseType")) :ruleset structural-type-consume)
(rule ((StructuralListTagDQ a a))
      ((panic "structural-type-inconsistent-tags: TypeList")) :ruleset structural-type-consume)
(rule ((StructuralTypeTagDQ a a))
      ((panic "structural-type-inconsistent-tags: Type")) :ruleset structural-type-consume)

; Preserve every obligation and every actual alternative for fail-closed audit.
; Coverage: 0 unsupported, 1 supported but not validated, 2 ground equal.
(rule ((ExpectType e expected message))
      ((set (StructuralTypeHasActual e expected) 0)) :ruleset type-helpers)
(rule ((ExpectType e expected message) (HasType e actual))
      ((set (StructuralTypeHasActual e expected) 1)
       (set (StructuralTypeCoverage e expected actual) 0)) :ruleset type-helpers)
(rule ((ExpectType e expected message) (HasType e actual)
       (StructuralGroundType expected) (StructuralGroundType actual))
      ((set (StructuralTypeCoverage e expected actual) 1)) :ruleset type-helpers)
(rule ((ExpectType e expected message) (HasType e expected) (StructuralGroundType expected))
      ((set (StructuralTypeCoverage e expected expected) 2)) :ruleset type-helpers)
