; Simple rewrites that don't do a ton with control flow.

(ruleset peepholes)

(rewrite (Bop (Mul) (Const (Int 0) ty ctx) e) (Const (Int 0) ty ctx) :ruleset peepholes)
(rewrite (Bop (Mul) e (Const (Int 0) ty ctx)) (Const (Int 0) ty ctx) :ruleset peepholes)
(rewrite (Bop (Mul) (Const (Int 1) ty ctx) e) e :ruleset peepholes)
(rewrite (Bop (Mul) e (Const (Int 1) ty ctx)) e :ruleset peepholes)
(rewrite (Bop (Add) (Const (Int 0) ty ctx) e) e :ruleset peepholes)
(rewrite (Bop (Add) e (Const (Int 0) ty ctx) ) e :ruleset peepholes)

(rewrite (Bop (Mul) (Const (Int j) ty ctx) (Const (Int i) ty ctx)) (Const (Int (* i j)) ty ctx) :ruleset peepholes)
(rewrite (Bop (Add) (Const (Int j) ty ctx) (Const (Int i) ty ctx)) (Const (Int (+ i j)) ty ctx) :ruleset peepholes)

(rewrite (Bop (And) (Const (Bool true) ty ctx) e) e :ruleset peepholes)
(rewrite (Bop (And) e (Const (Bool true) ty ctx)) e :ruleset peepholes)
(rewrite (Bop (And) (Const (Bool false) ty ctx) e) (Const (Bool false) ty ctx) :ruleset peepholes)
(rewrite (Bop (And) e (Const (Bool false) ty ctx)) (Const (Bool false) ty ctx) :ruleset peepholes)
(rewrite (Bop (Or) (Const (Bool false) ty ctx) e) e :ruleset peepholes)
(rewrite (Bop (Or) e (Const (Bool false) ty ctx)) e :ruleset peepholes)
(rewrite (Bop (Or) (Const (Bool true) ty ctx) e) (Const (Bool true) ty ctx) :ruleset peepholes)
(rewrite (Bop (Or) e (Const (Bool true) ty ctx)) (Const (Bool true) ty ctx) :ruleset peepholes)

(rule (
        (= expr (Bop (Sub) x x))
        (HasArgType expr ty)
        (ContextOf expr ctx)
      )
      ((union expr (Const (Int 0) ty ctx)))
      :ruleset peepholes)

; (x - y) + z => x + (z - y)
(rewrite (Bop (Add) (Bop (Sub) x y) z) (Bop (Add) x (Bop (Sub) z y)) :ruleset peepholes)

; (a + b) - c => a + (b - c)
(rewrite (Bop (Sub) (Bop (Add) a b) c) (Bop (Add) a (Bop (Sub) b c)) :ruleset peepholes)

; (a * x) + a => a * (x + 1)
(rule (
        (= expr (Bop (Add) (Bop (Mul) a x) a))
        (HasArgType expr ty)
        (ContextOf expr ctx)
      )
      ((union expr (Bop (Mul) a (Bop (Add) x (Const (Int 1) ty ctx)))))
      :ruleset peepholes)

(rewrite (Top (Select) pred x x) x :ruleset peepholes)

; constant fold `(x + const1) + const2` even when x is not constant
(rewrite (Bop (Add) (Bop (Add) x (Const (Int i) ty ctx)) (Const (Int j) ty ctx))
         (Bop (Add) x (Const (Int (+ i j)) ty ctx))
         :ruleset peepholes)

; ptradd(ptradd(p, x), y) => ptradd(p, x + y)
(rewrite (Bop (PtrAdd) (Bop (PtrAdd) p x) y)
         (Bop (PtrAdd) p (Bop (Add) x y))
         :ruleset peepholes)

; ================================================================
; Additional algebraic identities (all valid under i64 wraparound)
; ================================================================

; x - 0 = x
(rewrite (Bop (Sub) e (Const (Int 0) ty ctx)) e :ruleset peepholes)
; x / 1 = x
(rewrite (Bop (Div) e (Const (Int 1) ty ctx)) e :ruleset peepholes)

; bitwise-and idempotence and annihilation
(rewrite (Bop (Bitand) e e) e :ruleset peepholes)
(rewrite (Bop (Bitand) e (Const (Int 0) ty ctx)) (Const (Int 0) ty ctx) :ruleset peepholes)
(rewrite (Bop (Bitand) (Const (Int 0) ty ctx) e) (Const (Int 0) ty ctx) :ruleset peepholes)

; logical idempotence (And/Or are boolean operators)
(rewrite (Bop (And) e e) e :ruleset peepholes)
(rewrite (Bop (Or) e e) e :ruleset peepholes)

; double negation
(rewrite (Uop (Not) (Uop (Not) e)) e :ruleset peepholes)
; negation of an integer comparison flips it (integers are totally ordered).
; These target the integer comparisons only (not the float FLessThan etc., where
; NaN makes the equivalence unsound). Removes the Not node.
(rewrite (Uop (Not) (Bop (LessThan) a b)) (Bop (GreaterEq) a b) :ruleset peepholes)
(rewrite (Uop (Not) (Bop (GreaterThan) a b)) (Bop (LessEq) a b) :ruleset peepholes)
(rewrite (Uop (Not) (Bop (LessEq) a b)) (Bop (GreaterThan) a b) :ruleset peepholes)
(rewrite (Uop (Not) (Bop (GreaterEq) a b)) (Bop (LessThan) a b) :ruleset peepholes)
(rewrite (Uop (Neg) (Uop (Neg) e)) e :ruleset peepholes)
; -(a - b) = b - a
(rewrite (Uop (Neg) (Bop (Sub) a b)) (Bop (Sub) b a) :ruleset peepholes)

; 0 - x = -x  (drops the zero constant)
(rewrite (Bop (Sub) (Const (Int 0) ty ctx) x) (Uop (Neg) x) :ruleset peepholes)

; complementary boolean: x and (not x) = false ; x or (not x) = true
(rule ((= expr (Bop (And) x (Uop (Not) x))) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool false) ty ctx))) :ruleset peepholes)
(rule ((= expr (Bop (And) (Uop (Not) x) x)) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool false) ty ctx))) :ruleset peepholes)
(rule ((= expr (Bop (Or) x (Uop (Not) x))) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool true) ty ctx))) :ruleset peepholes)
(rule ((= expr (Bop (Or) (Uop (Not) x) x)) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool true) ty ctx))) :ruleset peepholes)

; select with a negated predicate: swap the arms, absorbing the Not
(rewrite (Top (Select) (Uop (Not) c) a b) (Top (Select) c b a) :ruleset peepholes)

; min/max with self
(rewrite (Bop (Smin) x x) x :ruleset peepholes)
(rewrite (Bop (Smax) x x) x :ruleset peepholes)

; bitwise-and with all-ones (-1 = 0xFFFF...FFFF in two's complement) is identity
(rewrite (Bop (Bitand) e (Const (Int -1) ty ctx)) e :ruleset peepholes)
(rewrite (Bop (Bitand) (Const (Int -1) ty ctx) e) e :ruleset peepholes)

; shifting by 0 is identity (logical shifts)
(rewrite (Bop (Shl) e (Const (Int 0) ty ctx)) e :ruleset peepholes)
(rewrite (Bop (Shr) e (Const (Int 0) ty ctx)) e :ruleset peepholes)

; cancellation identities (all valid under i64 wraparound)
; (a + b) - a = b   and   (a + b) - b = a
(rewrite (Bop (Sub) (Bop (Add) a b) a) b :ruleset peepholes)
(rewrite (Bop (Sub) (Bop (Add) a b) b) a :ruleset peepholes)
; a - (a - b) = b
(rewrite (Bop (Sub) a (Bop (Sub) a b)) b :ruleset peepholes)
; a + (b - a) = b   and   (b - a) + a = b
(rewrite (Bop (Add) a (Bop (Sub) b a)) b :ruleset peepholes)
(rewrite (Bop (Add) (Bop (Sub) b a) a) b :ruleset peepholes)

; self-comparisons (integer comparisons, always defined)
(rule ((= expr (Bop (Eq) x x)) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool true) ty ctx))) :ruleset peepholes)
(rule ((= expr (Bop (LessThan) x x)) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool false) ty ctx))) :ruleset peepholes)
(rule ((= expr (Bop (GreaterThan) x x)) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool false) ty ctx))) :ruleset peepholes)
(rule ((= expr (Bop (LessEq) x x)) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool true) ty ctx))) :ruleset peepholes)
(rule ((= expr (Bop (GreaterEq) x x)) (HasArgType expr ty) (ContextOf expr ctx))
      ((union expr (Const (Bool true) ty ctx))) :ruleset peepholes)